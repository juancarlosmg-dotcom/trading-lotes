{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trading-lotes/esquema_spec.schema.json",
  "title": "spec sellada de un lote (F222)",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "code_commit", "code_subtree", "data_cut", "seed_master",
               "derivacion_semilla", "calculo", "unidades", "parametros",
               "reglas_parada", "outputs", "ledger_id"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "descripcion": {"type": "string"},
    "code_commit": {"type": "string", "minLength": 7},
    "code_subtree": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/][^\u0000]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "data_cut": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": {"enum": ["SINTETICO", "FICHERO"]},
        "generador": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "seed_master": {"type": "string", "minLength": 1},
    "derivacion_semilla": {"const": "sha256(seed_master||':'||i)[:16] -> SeedSequence -> PCG64"},
    "calculo": {"type": "string", "minLength": 1},
    "unidades": {"type": "integer", "minimum": 1},
    "parametros": {"type": "object"},
    "reglas_parada": {
      "type": "object",
      "required": ["estadistico_que_decide", "umbral", "max_segundos_unidad",
                   "max_ram_mb_unidad", "latido_segundos"],
      "properties": {
        "estadistico_que_decide": {"type": "string"},
        "umbral": {},
        "max_segundos_unidad": {"type": "number", "exclusiveMinimum": 0},
        "max_ram_mb_unidad": {"type": "number", "exclusiveMinimum": 0},
        "latido_segundos": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "outputs": {"type": "array", "items": {"type": "string"}},
    "ledger_id": {"type": "string", "minLength": 1},
    "arranque_runtime": {
      "description": "F227/id 232: los modulos que el runner IMPORTA antes de correr_lote; lista (todos obligatorios) o el texto que los nombra (alternativas). Lo consume lotes/arranque.py.",
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "entradas": {
      "description": "F236: ficheros de ENTRADA del lote. Viajan en el Drive DEL USUARIO bajo CARPETA_DRIVE/<carpeta>/, NUNCA en el repositorio publico (dato en bruto PROHIBIDO). El cuaderno los verifica contra estos sha256 ANTES del primer sorteo y la aceptacion exige que el lote cite el mismo conjunto (salida 14).",
      "type": "object", "additionalProperties": false,
      "required": ["ficheros"],
      "properties": {
        "carpeta": {"type": "string", "pattern": "^entradas/[a-z0-9][a-z0-9_]*$"},
        "variable_entorno": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "ficheros": {
          "description": "CONJUNTO de ficheros, no lista: `uniqueItems` rechaza el duplicado IDENTICO. JSON Schema no sabe exigir unicidad POR CLAVE, asi que un `nombre` repetido con otro bytes/sha256 lo rechaza la celda 5 del cuaderno (ENTRADA DUPLICADA), no este esquema (F236 pase 2, C3).",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["nombre", "bytes", "sha256"],
            "properties": {
              "nombre": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "reference_runtime_s": {"type": "number", "minimum": 0},
    "valores_esperados": {
      "type": "object",
      "required": ["unidades"],
      "properties": {
        "nota": {"type": "string"},
        "unidades": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["unidad", "sha256_dato"],
            "properties": {
              "unidad": {"type": "integer", "minimum": 0},
              "sha256_dato": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "media": {"type": "number"},
              "desviacion": {"type": "number"},
              "minimo": {"type": "number"},
              "maximo": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
